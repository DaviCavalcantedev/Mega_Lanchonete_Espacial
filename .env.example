# Copie este arquivo para ".env" e remova o # das linhas que quiser usar.
# O arquivo .env NUNCA deve ir para o GitHub (já está no .gitignore).

# ---- E-mail (opcional) ----
# Sem SMTP_HOST, os e-mails são apenas SIMULADOS: ficam salvos em dados/emails/ (arquivos .eml)
# e o terminal mostra um aviso. Para enviar de verdade, preencha as linhas abaixo.
#
# Exemplo com Gmail (precisa de verificação em duas etapas e uma "senha de app":
# https://myaccount.google.com/apppasswords). Não use a senha normal da conta.
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_SEGURANCA=starttls
#SMTP_USUARIO=seuemail@gmail.com
#SMTP_SENHA=senha-de-app-de-16-letras
#SMTP_REMETENTE=seuemail@gmail.com

# ---- Servidor (opcional) ----
#PORT=3000
#DB_ARQUIVO=dados/mega_lanchonete.sqlite3
#MLE_PRODUCAO=true
